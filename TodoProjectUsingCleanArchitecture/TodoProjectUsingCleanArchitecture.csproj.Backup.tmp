<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9afcbfeb-8559-4dc6-a650-06f9b771e13f</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1-Preview.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Application\Database\Demo\" />
    <Folder Include="Application\Database\Real\" />
    <Folder Include="Contract\Request\" />
    <Folder Include="Contract\Response\" />
    <Folder Include="Controllers\" />
    <Folder Include="Presentation\" />
  </ItemGroup>

</Project>
